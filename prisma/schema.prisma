generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

// generator zod {
//   provider = "zod-prisma-types"
// }

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model accounts {
  id            Int             @id @default(autoincrement())
  name          String          @default("")
  nickname      String          @default("")
  password      String          @default("")
  image         String          @default("")
  apiToken      String          @default("")
  description   String          @default("")
  note          Int             @default(0)
  role          String          @default("")
  loginType     String          @default("")
  linkAccountId Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  notes         notes[]
  configs       config[]
  tags          tag[]
  comments      comments[]
  attachments   attachments[]
  follows       follows[]
  notifications notifications[]
  conversations conversation[]
  sharedNotes   noteInternalShare[]
  aiProviders   aiProviders[]
  aiModels      aiModels[]
  // 协作模块反向关系
  ownedTeams         teams[]            @relation("OwnedTeams")
  teamMembers        teamMembers[]
  invitesCreated     inviteLinks[]
  teamActivities     teamActivities[]
  teamNotesShared    teamNotes[]
  teamNoteMembers    teamNoteMembers[]
}

model attachments {
  id            Int      @id @default(autoincrement())
  isShare       Boolean  @default(false)
  sharePassword String   @default("")
  name          String   @default("")
  path          String   @default("")
  size          Int      @default(0)
  type          String   @default("")
  noteId        Int?
  accountId     Int?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  perfixPath    String?  @default("") // folder1,folder2,folder3
  depth         Int?
  metadata      String?

  note    notes?    @relation(fields: [noteId], references: [id])
  account accounts? @relation(fields: [accountId], references: [id])
}

model config {
  id     Int       @id @default(autoincrement())
  key    String    @default("")
  config String?
  userId Int?
  user   accounts? @relation(fields: [userId], references: [id])
}

model notes {
  id                Int             @id @default(autoincrement())
  type              Int             @default(0)
  content           String          @default("")
  isArchived        Boolean         @default(false)
  isRecycle         Boolean         @default(false)
  isShare           Boolean         @default(false)
  isTop             Boolean         @default(false)
  isReviewed        Boolean         @default(false)
  sharePassword     String          @default("")
  shareEncryptedUrl String?
  shareExpiryDate   DateTime?
  shareMaxView      Int?            @default(0)
  shareViewCount    Int?            @default(0)
  metadata          String?
  accountId         Int?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  attachments       attachments[]
  tags              tagsToNote[]
  account           accounts?       @relation(fields: [accountId], references: [id])
  referencedBy      noteReference[] @relation("ReferencedNote")
  references        noteReference[] @relation("ReferencingNote")
  comments          comments[]      @relation("NoteComments")
  histories         noteHistory[]
  internalShares    noteInternalShare[]
  // 协作模块:笔记属于某个团队
  teamShares        teamNotes[]
}

model comments {
  id        Int      @id @default(autoincrement())
  content   String
  accountId Int?
  guestName String?
  guestIP   String?
  guestUA   String?
  noteId    Int
  parentId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note    notes      @relation("NoteComments", fields: [noteId], references: [id])
  account accounts?  @relation(fields: [accountId], references: [id])
  parent  comments?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies comments[] @relation("CommentReplies")
}

model tag {
  id         Int          @id @default(autoincrement())
  name       String       @default("")
  icon       String       @default("")
  parent     Int          @default(0)
  accountId  Int?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tagsToNote tagsToNote[]
  sortOrder  Int          @default(0)
  account    accounts?    @relation(fields: [accountId], references: [id])
}

model tagsToNote {
  noteId Int @default(0)
  tagId  Int @default(0)

  note notes @relation(fields: [noteId], references: [id])
  tag  tag   @relation(fields: [tagId], references: [id])

  @@id([noteId, tagId])
}

model noteReference {
  id         Int      @id @default(autoincrement())
  fromNoteId Int
  toNoteId   Int
  createdAt  DateTime @default(now())

  fromNote notes @relation("ReferencingNote", fields: [fromNoteId], references: [id])
  toNote   notes @relation("ReferencedNote", fields: [toNoteId], references: [id])

  @@unique([fromNoteId, toNoteId])
}

model follows {
  id          Int     @id @default(autoincrement())
  siteName    String?
  siteUrl     String
  siteAvatar  String?
  description String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  followType String   @default("following") //  "following" or "follower"

  accountId Int
  account   accounts @relation(fields: [accountId], references: [id])
}

model notifications {
  id        Int      @id @default(autoincrement())
  type      String // follow, comment, mention 等
  title     String
  content   String
  metadata  String?
  isRead    Boolean  @default(false)
  accountId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account accounts @relation(fields: [accountId], references: [id])
}

model cache {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model conversation {
  id        Int       @id @default(autoincrement())
  title     String    @default("")
  isShare   Boolean   @default(false)
  accountId Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  message[]

  account accounts @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

model message {
  id             Int      @id @default(autoincrement())
  content        String
  role           String // user or assistant
  conversationId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  metadata       String?

  conversation conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

model noteHistory {
  id        Int      @id @default(autoincrement())
  noteId    Int
  content   String
  metadata  String?
  version   Int
  accountId Int?
  createdAt DateTime @default(now())

  note notes @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([accountId])
}

model noteInternalShare {
  id        Int      @id @default(autoincrement())
  noteId    Int
  accountId Int
  canEdit   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note    notes    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  account accounts @relation(fields: [accountId], references: [id])

  @@unique([noteId, accountId])
  @@index([noteId])
  @@index([accountId])
}

model session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model aiProviders {
  id        Int      @id @default(autoincrement())
  accountId Int?
  title     String
  provider  String
  baseURL   String?
  apiKey    String?
  config    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   accounts?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  models    aiModels[]

  @@index([accountId])
}

model aiModels {
  id            Int      @id @default(autoincrement())
  accountId     Int?
  providerId    Int
  title         String
  modelKey      String
  capabilities  String
  config        String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider      aiProviders @relation(fields: [providerId], references: [id], onDelete: Cascade)
  account       accounts?   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([accountId])
}

// ============================================================
// 协作模块:5 个新 model (Phase 1 of 协作功能)
// ============================================================

model teams {
  id          Int      @id @default(autoincrement())
  name        String
  icon        String   @default("")
  description String   @default("")
  ownerId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     accounts         @relation("OwnedTeams", fields: [ownerId], references: [id])
  members   teamMembers[]
  invites   inviteLinks[]
  notes     teamNotes[]
  activity  teamActivities[]

  @@index([ownerId])
}

model teamMembers {
  id           Int       @id @default(autoincrement())
  teamId       Int
  accountId    Int
  role         String    @default("member") // owner | admin | member | guest
  status       String    @default("active") // active | pending
  joinedAt     DateTime  @default(now())
  lastActiveAt DateTime?

  team    teams    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  account accounts @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([teamId, accountId])
  @@index([accountId])
}

model inviteLinks {
  id          Int       @id @default(autoincrement())
  teamId      Int
  token       String    @unique           // URL 中使用的随机字符串
  name        String    @default("")
  role        String    @default("member") // 加入后的角色
  expiresAt   DateTime?                    // null = 永久
  maxUses     Int?                          // null = 不限
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  createdById Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  team      teams    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy accounts @relation(fields: [createdById], references: [id])

  @@index([teamId])
  @@index([token])
}

model teamActivities {
  id         Int      @id @default(autoincrement())
  teamId     Int
  accountId  Int?
  action     String                                 // 'member.add' | 'member.remove' | 'role.change' | 'invite.create' | 'invite.use' | 'note.share' | 'team.update' ...
  targetType String?                                // 'note' | 'member' | 'invite' | 'team'
  targetId   Int?
  metadata   String?                                // JSON-encoded 额外上下文
  createdAt  DateTime @default(now())

  team    teams     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  account accounts? @relation(fields: [accountId], references: [id])

  @@index([teamId, createdAt])
  @@index([accountId])
}

model teamNotes {
  id         Int      @id @default(autoincrement())
  teamId     Int
  noteId     Int
  canEdit    Boolean  @default(true)
  sharedById Int
  createdAt  DateTime @default(now())

  team     teams    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  note     notes    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  sharedBy accounts @relation(fields: [sharedById], references: [id])
  members  teamNoteMembers[]

  @@unique([teamId, noteId])
  @@index([noteId])
}

/// 团队笔记成员权限表 — 决定哪些成员实际可以访问该团队笔记
model teamNoteMembers {
  id         Int      @id @default(autoincrement())
  teamNoteId Int
  accountId  Int
  canEdit    Boolean  @default(true)
  createdAt  DateTime @default(now())

  teamNote teamNotes @relation(fields: [teamNoteId], references: [id], onDelete: Cascade)
  account  accounts  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([teamNoteId, accountId])
  @@index([accountId])
}





