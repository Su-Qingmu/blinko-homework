    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "openai": "^4.73.0",
    "superjson": "^2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.0",
    "bun-types": "^1.3.14",
    "prisma": "^5.22.0",
    "typescript": "^5.6.2"
  }
